# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gokaasa_db
DB_USER=postgres
DB_PASSWORD=Aqil@123
# Leave DB_SSL=false in development; set it to true for a managed/production Postgres instance.
DB_SSL=false
FRONTEND_URL=http://localhost:5173
TRUST_PROXY=0

# At least 32 random characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30
BCRYPT_ROUNDS=12

# Email. Leave SMTP_HOST empty in development to print emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gokaasa <no-reply@gokaasa.com>

# Hotel data providers, comma-separated. Providers without credentials are skipped automatically.
HOTEL_PROVIDERS=openstreetmap,google_places,mock
OSM_USER_AGENT=GokaasaHotelOnboarding/0.1 (ops@gokaasa.com)
GOOGLE_MAPS_API_KEY=
HOTEL_API_KEY=
IMPORT_JOB_CONCURRENCY=2

# Pilot/dev only: lets a hotel with no real property photo (an explicitly-labelled illustrative image
# only) satisfy the publish gate, for demoing a hotel catalog before real photos exist. Backend-only,
# never sent to the frontend, and force-disabled whenever NODE_ENV=production regardless of this value.
ALLOW_ILLUSTRATIVE_HOTEL_IMAGES=false

# Booking holds: how long a room stays reserved while the guest completes payment.
HOLD_DURATION_MINUTES=15
# Business time zone for "today" (hotels can override this per hotel).
BUSINESS_TIMEZONE=Asia/Kolkata

# Razorpay. Leave empty in development to use the simulated gateway (refused in production).
# No webhook is used: payment confirmation is entirely backend-authoritative via POST /payments/verify,
# which re-fetches the payment from Razorpay's API before confirming -- see src/services/payment.service.js.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# First administrator, created by `npm run seed`. Password must be at least 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# AI-powered natural-language booking assistant (Mode B). Entirely optional: the guided chatbot works
# fully without any of these set. Leave AI_API_BASE_URL/AI_API_KEY empty to keep AI mode off.
# AI_API_BASE_URL expects an OpenAI-compatible chat-completions base URL, e.g. https://api.openai.com/v1
# (works with OpenAI itself, or any OpenAI-compatible gateway, including a self-hosted one).
AI_PROVIDER=openai-compatible
AI_MODEL=gpt-4o-mini
AI_API_BASE_URL=
AI_API_KEY=
AI_REQUEST_TIMEOUT_MS=12000

# Authenticated session presence (the admin "who's online" dashboard). The client should heartbeat at
# roughly PRESENCE_HEARTBEAT_SECONDS; a session with no heartbeat for PRESENCE_ONLINE_TIMEOUT_SECONDS is
# shown offline, and one left stale for PRESENCE_SESSION_EXPIRE_MINUTES is closed by the cleanup sweep.
PRESENCE_HEARTBEAT_SECONDS=30
PRESENCE_ONLINE_TIMEOUT_SECONDS=90
PRESENCE_AWAY_TIMEOUT_SECONDS=300
PRESENCE_SESSION_EXPIRE_MINUTES=60
PRESENCE_CLEANUP_INTERVAL_MS=300000

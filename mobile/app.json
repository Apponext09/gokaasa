{
  "expo": {
    "name": "Gokaasa",
    "slug": "gokaasa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-square.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/62186116-5614-43f0-96ff-71f83daec282"
    },
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f4"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.apponext.gokaasa",
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#faf8f4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-updates",
      "expo-secure-store",
      "expo-image",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      "expo-sharing",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "62186116-5614-43f0-96ff-71f83daec282"
      }
    },
    "owner": "swayam-lala"
  }
}

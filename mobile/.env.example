# Copy to .env (never commit .env). Expo inlines any EXPO_PUBLIC_* variable at build/bundle time --
# restart `expo start` after changing this file, env vars are only read at bundler start.
#
# PRODUCTION (default): the live Gokaasa backend, reached over HTTPS through Nginx. The backend's real
# listening port (5015) is private and is never used by this app -- only the public HTTPS domain is.
EXPO_PUBLIC_API_URL=https://gokaasa.apponext.in/api
#
# Everything below is for LOCAL DEVELOPMENT ONLY, against a backend you're running yourself from
# C:\Gokaasa\backend (npm run dev). Uncomment exactly one and comment out the production line above.
#
# 1) Android emulator (AVD) + backend on this same development machine:
#    Android emulators route 10.0.2.2 to the host machine's localhost.
# EXPO_PUBLIC_API_URL=http://10.0.2.2:4000/api
#
# 2) A physical Android phone (Expo Go) + backend on this development machine:
#    The phone cannot reach "localhost" (that means the phone itself). Use this machine's LAN IP
#    instead (Windows: `ipconfig`, look for the Wi-Fi adapter's IPv4 address), e.g.:
# EXPO_PUBLIC_API_URL=http://192.168.1.23:4000/api
